FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN VITE_API_BASE_URL='' VITE_SENTRY_DSN='' npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api
WORKDIR /src
COPY global.json ./
COPY src/PokerHub.Api/ src/PokerHub.Api/
COPY src/PokerHub.Application/ src/PokerHub.Application/
COPY src/PokerHub.Infrastructure/ src/PokerHub.Infrastructure/
COPY src/PokerHub.Domain/ src/PokerHub.Domain/
RUN dotnet publish src/PokerHub.Api -c Release -o /publish -m:1 /p:UseAppHost=false /p:UseSharedCompilation=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=api /publish ./
COPY --from=web /web/dist ./wwwroot/
ENV ASPNETCORE_HTTP_PORTS=8080 ASPNETCORE_ENVIRONMENT=Preview Preview__ServeWeb=true
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "PokerHub.Api.dll"]
